{
  "name": "faultline",
  "version": "1.0.0",
  "description": "Resilience-first PR review agent — finds silent resilience failures before they cause production outages",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:dashboard": "cd src/dashboard && npm run build",
    "build:all": "npm run build && npm run build:dashboard",
    "start": "node dist/server/webhook.js",
    "dev": "ts-node src/server/webhook.ts",
    "analyze": "ts-node src/cli.ts",
    "test": "jest --config jest.config.js",
    "test:patterns": "jest --config jest.config.js --testPathPattern=detectors",
    "lint": "eslint src/ --ext .ts",
    "self-review": "ts-node src/cli.ts --self-review"
  },
  "keywords": [
    "resilience",
    "code-review",
    "pr-review",
    "reliability",
    "sre",
    "fault-tolerance",
    "truefoundry",
    "bedrock"
  ],
  "author": "Faultline Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@octokit/rest": "^21.0.0",
    "@octokit/webhooks": "^13.0.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "openai": "^4.73.0",
    "ora": "^5.4.1",
    "uuid": "^10.0.0",
    "winston": "^3.17.0",
    "yargs": "^17.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/yargs": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
