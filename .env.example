# === TrueFoundry AI Gateway ===
TRUEFOUNDRY_GATEWAY_URL=https://your-workspace.truefoundry.cloud/api/llm/gateway
TRUEFOUNDRY_API_KEY=tfy-xxx

# === TrueFoundry MCP Gateway ===
TRUEFOUNDRY_MCP_GATEWAY_URL=https://your-workspace.truefoundry.cloud/api/mcp/gateway

# === GitHub ===
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your-webhook-hmac-secret
GITHUB_TOKEN=ghp_xxx

# === Jira (optional) ===
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=service@yourorg.com
JIRA_API_TOKEN=jira-api-token

# === Slack (optional) ===
SLACK_BOT_TOKEN=xoxb-xxx
SLACK_ALERT_CHANNEL=C0123456789

# === AWS ===
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_CHECKPOINT_BUCKET=faultline-checkpoints

# === Server ===
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
